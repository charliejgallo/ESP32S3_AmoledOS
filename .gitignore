# ---- ESP-IDF build output -------------------------------------------------
build/
apps/*/build/
sim/build/

# Pulled by the component manager, not by us.
managed_components/
apps/*/managed_components/
dependencies.lock
apps/*/dependencies.lock

# Generated from sdkconfig.defaults on the first build. The defaults are
# tracked; the expanded config is not.
sdkconfig
sdkconfig.old
apps/*/sdkconfig
apps/*/sdkconfig.old

# ---- Simulator ------------------------------------------------------------
# Vendored LVGL checkout and the fake SD card the simulator writes into.
sim/lvgl/
sim/sim_fs/
sim_fs/prefs.txt
sim_fs/recordings/*
sim_fs/photos/*
!sim_fs/**/.gitkeep

# ---- Local scratch --------------------------------------------------------
*.zip
*.tar.gz
*.bak
*.old
__pycache__/
*.pyc
.DS_Store
compile_commands.json

# Handoff notes written for the next coding session, not for readers of the
# repository. Kept on disk, out of git.
docs/internal/
night-*.csv

# Blender previews: regenerated by apps/golf/tools/blender/preview.py
apps/golf/tools/blender/preview/
# regenerated by apps/turbo/tools/blender/cars_preview.py and props_preview.py
apps/turbo/assets/cars_preview/
apps/turbo/assets/props_preview/
sim/build-asan/
# Monster Hop: what the tools regenerate. The renders and monsterhop.pak are
# tracked (as Turbo's are); these are not:
# the agents' contact sheets and scenes (tools/blender/*_sheet.py, *_scene.py)
apps/monsterhop/assets/*/_*
# the pack again, in parts for the portal's 8 MB uploads (tools/pack_assets.py)
apps/monsterhop/assets/card/
# the compiled levels and their previews (tools/levels.py [--preview])
apps/monsterhop/assets/levels/
# Mila: the same. Renders and mila.pak are tracked; the style samples and
# the agents' sheets, the pack in parts, the compiled levels and the level
# generator's candidates (tools/gen.py) are not.
apps/mila/assets/_*
apps/mila/assets/*/_*
apps/mila/assets/card/
apps/mila/assets/levels/
apps/mila/tools/levels/_cand/
